# GitLab Runner 镜像版本，格式为 x.y.z；升级时修改这一项。
GITLAB_RUNNER_VERSION=19.3.0

# 可选：Runner manager 镜像仓库（不含 tag），默认 gitlab/gitlab-runner。
# 使用 GitLab 官方镜像仓库时取消下一行注释；版本仍由上方控制。
# GITLAB_RUNNER_IMAGE_REPOSITORY=registry.gitlab.com/gitlab-org/gitlab-runner

# Runner manager 的全局 Job 并发数，是所有 Runner 合计的并发上限，必须为正整数。
RUNNER_CONCURRENT=1
